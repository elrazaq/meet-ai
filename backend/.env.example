# Konfigurasi Google AI (Gemini / Vertex AI)
# Anda bisa menggunakan Gemini API Key Organisasi atau Google Application Credentials (GCP Service Account)
GEMINI_API_KEY=AIzaSyYourOrganizationApiKeyHere

# Model Gemini Multimodal Audio (Default: gemini-2.5-flash atau gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Konfigurasi Server
PORT=8000
HOST=0.0.0.0

# Direktori Penyimpanan Audio & Dokumen Output
STORAGE_DIR=./storage
